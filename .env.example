# Flask
FLASK_ENV=production
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Dominio — usado pelo Nginx e pelo Certbot
# Exemplo: portal.suaempresa.com.br
DOMAIN=portal.suaempresa.com.br
# E-mail para notificacoes de expiracao do certificado
CERTBOT_EMAIL=admin@suaempresa.com.br

# Database (deve apontar para o servico 'db' do docker-compose)
DATABASE_URL=mysql+pymysql://portal:portalsecret@db:3306/unifi_portal
MYSQL_ROOT_PASSWORD=rootsecret
MYSQL_DATABASE=unifi_portal
MYSQL_USER=portal
MYSQL_PASSWORD=portalsecret

# UniFi
# Usado para semear a loja 'default' na primeira migracao e como fallback.
# Cada loja adicional e cadastrada pelo painel admin (Lojas), com suas
# proprias credenciais do UDM Pro daquela unidade.
UNIFI_BASE_URL=https://192.168.1.1/proxy/network/integration
UNIFI_API_KEY=sua-api-key-do-unifi
UNIFI_SITE_ID=default
UNIFI_SESSION_MINUTES=480
UNIFI_VERIFY_SSL=false
# Modo mock: nao faz chamadas reais ao controlador, apenas simula respostas.
# Em branco = automatico (mock ligado quando FLASK_ENV=development).
# Use false para testar contra um controlador real sem sair do modo development.
UNIFI_MOCK=

# Webhook / Integracoes
# Defina como true em ambientes on-premise onde o destino do webhook
# e um endereco interno (192.168.x.x, 10.x.x.x, etc.)
ALLOW_PRIVATE_WEBHOOK=false

# Privacidade / LGPD
TERMS_VERSION=1.0
PRIVACY_POLICY_URL=/politica-de-privacidade

# Seguranca (Fernet para criptografia de dados PII - opcional)
FERNET_KEY=
