FLASK_APP=wsgi.py
FLASK_ENV=production
SECRET_KEY=troque-para-uma-chave-segura

# Banco — hostname = nome do servico no docker-compose
DATABASE_URL=mysql+pymysql://portal:portalsecret@db/unifi_portal

# Variaveis do MySQL (usadas pelo servico db)
MYSQL_ROOT_PASSWORD=rootsecret
MYSQL_DATABASE=unifi_portal
MYSQL_USER=portal
MYSQL_PASSWORD=portalsecret

# UniFi
UNIFI_BASE_URL=https://unifi.seudominio.com/proxy/network/integration
UNIFI_API_KEY=coloque_sua_api_key
UNIFI_SITE_ID=default
GUEST_AUTH_MINUTES=480

WTF_CSRF_ENABLED=true
